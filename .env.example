# ── Core (required) ─────────────────────────────────────────────────────────
# Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service-role key — server only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Clerk → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Clerk → Webhooks → /api/webhooks/clerk (events: user.created, user.updated, user.deleted)
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# ── AI (optional at build time; app guards at runtime) ─────────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# ── Payments (optional at build time; app guards at runtime) ────────────────
# https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
# Razorpay → Settings → Webhooks (event: payment.captured)
RAZORPAY_WEBHOOK_SECRET=...

# ── Email invites (optional; falls back to shareable invite code) ───────────
# https://resend.com
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=CareDesk <onboarding@resend.dev>

# ── Misc (optional) ─────────────────────────────────────────────────────────
# Public URL used in invite emails when request origin is unavailable
APP_URL=http://localhost:3000

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
